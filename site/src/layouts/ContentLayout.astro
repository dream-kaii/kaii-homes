---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  active?: string;
  hasLeft?: boolean;
  hasRight?: boolean;
}
const { title, description, active, hasLeft = true, hasRight = true } = Astro.props;
---
<BaseLayout title={title} description={description} active={active}>
  <div class="shell" data-left={hasLeft} data-right={hasRight}>
    {hasLeft && (
      <aside class="rail-l self-start pt-14">
        <slot name="left" />
      </aside>
    )}
    {/* 主 landmark。用 <main> 而不是 <div class="mid">：
        首页在 Task 8 已补了 <main>，但 ContentLayout 承载的 7 个页面（项目列表 / 项目详情×3 /
        文章列表 / 文章详情×8 / 后续的学习路线、关于页）此前都没有主 landmark，
        屏幕阅读器无法跳转到正文。三栏里只有中栏是正文，左右两栏是 <aside>，语义正好对上。
        样式由 .mid 承担，<main> 不改变布局（display 未声明，沿用 grid item 默认行为）。 */}
    <main class="mid" id="main">
      <slot />
    </main>
    {hasRight && (
      <aside class="rail-r self-start pt-14">
        <slot name="right" />
      </aside>
    )}
  </div>
</BaseLayout>

<!--
  代码块复制按钮。服务端**不**生成按钮，而是在客户端注入 —— 这样无 JS 时
  不会留下一个点了没反应的死按钮（Global Constraints：无 JS 不能出现假交互）。
  用事件委托挂在 document 上，覆盖本布局里所有 `.prose-k pre`（文章页 + 项目页）。
-->
<script>
  // @ts-nocheck —— 浏览器运行时 JS，理由同 TrackTabs.astro。
  const COPY_TEXT = { idle: '复制', done: '已复制' };
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.code-copy');
    if (!btn) return;
    const pre = btn.closest('pre');
    if (!pre) return;
    const code = pre.querySelector('code');
    const text = (code || pre).innerText.replace(/\n$/, '');
    try {
      await navigator.clipboard.writeText(text);
      btn.textContent = COPY_TEXT.done;
      btn.classList.add('is-done');
      setTimeout(() => {
        btn.textContent = COPY_TEXT.idle;
        btn.classList.remove('is-done');
      }, 1600);
    } catch {
      // 剪贴板不可用（非 HTTPS / 权限被拒）：退回选中文本，不弹任何提示
      const r = document.createRange();
      r.selectNodeContents(code || pre);
      const sel = getSelection();
      sel.removeAllRanges();
      sel.addRange(r);
    }
  });

  // 注入按钮：每个代码块一个
  document.querySelectorAll('.prose-k pre').forEach((pre) => {
    if (pre.querySelector('.code-copy')) return;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'code-copy';
    btn.textContent = COPY_TEXT.idle;
    btn.setAttribute('aria-label', '复制这段代码');
    pre.appendChild(btn);
  });
</script>

<style>
  .shell {
    margin: 0 auto; max-width: 1440px; padding: 0 2.5rem;
    display: grid; gap: 3.5rem; align-items: start;
    grid-template-columns: 212px minmax(0, 740px) 236px;
    justify-content: center;
  }
  .shell[data-right="false"] { grid-template-columns: 212px minmax(0, 740px); }
  .shell[data-left="false"]  { grid-template-columns: minmax(0, 740px) 236px; }
  .shell[data-left="false"][data-right="false"] { grid-template-columns: minmax(0, 740px); }
  .mid { min-width: 0; }
  .rail-l, .rail-r { position: sticky; top: 96px; }

  @media (max-width: 1320px) {
    .shell { grid-template-columns: 212px minmax(0, 740px); gap: 3.25rem; }
    .rail-r { display: none; }
  }
  @media (max-width: 1080px) {
    .shell { grid-template-columns: minmax(0, 1fr); gap: 0; padding: 0 1.5rem; max-width: 820px; }
    .rail-l, .rail-r { display: none; }
  }
  @media (max-width: 700px) {
    .shell { padding: 0 1rem; }
  }
</style>
