---
import { site } from '../data/site';

const githubLabel = site.github.replace(/^https?:\/\//, '');
// 徽章文案由 site.available 驱动（Task 5 遗留项 2：该字段此前全仓库零引用）。
// available 为 false 时不出现「开放」字样，改用中性的「欢迎交流」。
const badgeText = site.available ? '开放实习机会' : '欢迎交流';
---

<section class="hero" id="hero">
  <div class="hero-art" id="hero-art"></div>
  <div class="hero-glow" id="hero-glow"></div>

  <div class="mx-auto max-w-[1180px] px-8">
    <div class="hero-grid" id="hero-grid">
      <!-- 左：文案 -->
      <div class="hero-left">
        <span class="badge"><span class="dot"></span>{badgeText}</span>

        <h1>你好，我是 <span class="hl">{site.name}</span></h1>

        <p class="hero-role">{site.cohort} · {site.role}</p>

        <p class="lede">
          欢迎来到我的小站。我在做的是 <b class="term" data-tip="能自己查资料、自己调工具办事的 AI，而不只是陪你聊天">Agent 应用</b> ——
          <b class="plain">能自己查资料、自己动手办事的 AI</b>，而不只是陪你聊天。<br />
          这里记录我在这条路上的实践，和踩过的坑。
        </p>

        <div class="hero-btns">
          <a href="/projects/" class="btn btn-p">
            看看我的项目
            <svg class="ar" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a href="/writing/" class="btn btn-w">读技术文章</a>
        </div>

        <div class="hero-social">
          <a href={site.github} target="_blank" rel="noopener" title="GitHub" aria-label="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4 1.5-4-2.5-6-3m12 5v-3.9a3.4 3.4 0 0 0-1-2.6c3.2-.4 6.5-1.6 6.5-7A5.4 5.4 0 0 0 19 3.8a5 5 0 0 0-.1-3.7s-1.2-.4-3.9 1.4a13.4 13.4 0 0 0-7 0C5.3-.3 4.1 0 4.1 0A5 5 0 0 0 4 3.8 5.4 5.4 0 0 0 2.5 7.6c0 5.3 3.3 6.5 6.5 6.9a3.4 3.4 0 0 0-1 2.6V21" /></svg>
          </a>
          <a href={`mailto:${site.email}`} title="邮箱" aria-label="邮箱">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4z" /><path d="M4 6l8 6 8-6" /></svg>
          </a>
          <a href="/rss.xml" title="RSS" aria-label="RSS">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1.4" /></svg>
          </a>
        </div>
      </div>

      <!-- 右：技术名片 -->
      <div class="hero-right">
        <div class="idcard">
          <div class="idcard-hd">
            <img src="/avatar.jpg" alt="" class="idcard-av" width="46" height="46" />
            <div style="flex:1;min-width:0">
              <div class="idcard-n">{site.name}</div>
              <div class="idcard-s">{githubLabel}</div>
            </div>
            <span class="idcard-live"><span class="dot" style="width:6px;height:6px"></span>学习中</span>
          </div>

          <div class="idcard-bd">
            <div class="idrow"><span class="idk">方向</span><span class="idv">{site.role}</span></div>
            <div class="idrow"><span class="idk">正在学</span><span class="idv">检索与重排、图编排、上下文管理</span></div>
            <div class="idrow"><span class="idk">正在用</span><span class="idv mono">FastAPI · LangGraph · Milvus · Redis</span></div>
            <div class="idrow"><span class="idk">届别</span><span class="idv mono">{site.cohort}</span></div>
          </div>

          <div class="idcard-ft">
            <div><b>Agent</b><i>当前主攻方向</i></div>
            <div><b>Java</b><i>工程底子</i></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ============================================================
     HERO —— 自我介绍（左对本 / 右技术名片）
     迁移自 design-mockup/index-v9.html L66–147；Hero grid L77–78
     ============================================================ */
  .hero {
    position: relative;
    /* 用 `clip` 而不是 `hidden`：`.hero-art` 是带 `inset:-6% -4%` + `scale(1.05)` 的装饰层，
       在 1180–1269px 的视口区间它的右边缘比视口宽 5–45px。`overflow-x:hidden` 只裁剪绘制，
       **不会**把这段溢出从可滚动溢出链里摘掉 —— `.hero` 自身 scrollWidth 仍大于 clientWidth，
       并继续冒泡到 body / html（html 的 overflow-x 是 visible），
       最终表现为 document.scrollWidth > clientWidth（实测 1180px 下 1225 > 1180）。
       `clip` 是「连滚动容器都不创建」的裁剪，溢出不再参与祖先的 scrollWidth 计算，
       视觉结果与 `hidden` 完全一致（都是硬裁切，本区块也没有需要滚动的内容）。
       更早的溢出扫描没发现它：采样点从 1280 直接跳到 1100，正好跨过了这个区间。 */
    overflow: clip;
    background: linear-gradient(165deg, #d2e284 0%, #b5ca4d 34%, #8fa84e 68%, #6b9149 100%);
  }
  .hero-art {
    position: absolute;
    inset: -6% -4%;
    z-index: 0;
    background: url('/hero-bg.jpg') center 38% / cover no-repeat;
    opacity: 0.85;
    will-change: transform;
    /* 静息态就把 1.05 基准缩放写进基础规则：视差脚本只在 JS 可用时才接管 transform，
       减少动态效果 / 禁用 JS 时背景图不会因丢掉 scale 而整体缩小位移。 */
    transform: translate3d(0, 0, 0) scale(1.05);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero-art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(250, 249, 242, 0.62) 0%,
      rgba(250, 249, 242, 0.1) 24%,
      transparent 50%,
      rgba(250, 249, 242, 0.93) 100%
    );
  }
  .hero-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.42) 0%, transparent 66%);
    /* 兜底居中：left/top 只在 mousemove 里被赋值，脚本不注册时（reduce / 无 JS /
       触屏）会退回这里的 50%/50%，光晕圆心落在 Hero 中心，而不是左上角 (0,0)。 */
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.45s;
  }
  .hero:hover .hero-glow {
    opacity: 1;
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    gap: 56px;
    align-items: center;
    padding: 78px 0 84px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.87);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.93);
    color: var(--color-gk);
    font-size: 12px;
    font-weight: 600;
    padding: 6px 15px 6px 11px;
    border-radius: 100px;
    margin-bottom: 22px;
    box-shadow: 0 1px 3px rgba(42, 77, 46, 0.05);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-gd);
    animation: ripple 2.2s infinite;
    flex: none;
  }
  @keyframes ripple {
    0% { box-shadow: 0 0 0 0 rgba(62, 107, 63, 0.55); }
    70% { box-shadow: 0 0 0 9px rgba(62, 107, 63, 0); }
    100% { box-shadow: 0 0 0 0 rgba(62, 107, 63, 0); }
  }

  .hero h1 {
    font-size: clamp(38px, 5.4vw, 58px);
    font-weight: 800;
    letter-spacing: -0.042em;
    line-height: 1.08;
    color: #1a2415;
    margin-bottom: 14px;
    text-shadow: 0 2px 22px rgba(255, 255, 255, 0.45);
  }

  /* 荧光笔高亮：核心视觉记忆点 */
  .hl {
    position: relative;
    display: inline-block;
    z-index: 0;
  }
  .hl::before {
    content: '';
    position: absolute;
    left: -6px;
    right: -6px;
    bottom: 2px;
    height: 38%;
    z-index: -1;
    background: linear-gradient(100deg, rgba(232, 184, 75, 0.78), rgba(181, 202, 77, 0.62));
    border-radius: 5px 11px 6px 12px;
    transform: rotate(-1deg) scaleX(0);
    transform-origin: left;
    transition: transform 0.95s cubic-bezier(0.22, 1, 0.36, 1) 0.3s;
  }
  .hero-ready .hl::before {
    transform: rotate(-1deg) scaleX(1);
  }

  /* 无障碍 / 无 JS 兜底：脚本被禁用时也要能看到高亮，绝不能停在 scaleX(0)。
     脚本可用时由 <html class="js"> 覆盖回 scaleX(0) 起点，动画照常刷出。 */
  :root:not(.js) .hl::before {
    transform: rotate(-1deg) scaleX(1);
  }

  .hero-role {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: #3a4d2c;
    margin-bottom: 20px;
    letter-spacing: 0.01em;
    text-shadow: 0 1px 10px rgba(255, 255, 255, 0.5);
  }
  .hero .lede {
    font-size: 16px;
    color: #2c3a22;
    line-height: 1.85;
    font-weight: 450;
    text-shadow: 0 1px 14px rgba(255, 255, 255, 0.5);
    max-width: 520px;
    margin-bottom: 30px;
  }

  /* 术语悬停解释（.term）的样式已提升到 src/styles/global.css：
     `.term` 现有两个消费点（本组件的「Agent 应用」+ CapabilityGrid 的 5 处），
     Astro 的 <style> 作用域隔离会让组件各自编译出互不可见的 `.term[data-astro-cid-*]`，
     故改为全站唯一一份定义。此处不再重复声明。 */

  .hero-btns {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 26px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 100px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    border: 1.5px solid transparent;
    cursor: pointer;
    transition: transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.24s, background 0.24s;
  }
  .btn-p {
    background: var(--color-gk);
    color: #fff;
    box-shadow: 0 4px 16px rgba(42, 77, 46, 0.26);
  }
  .btn-p:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 9px 28px rgba(42, 77, 46, 0.32);
  }
  .btn-w {
    background: rgba(255, 255, 255, 0.93);
    color: var(--color-gd);
    border-color: #fff;
    box-shadow: 0 1px 3px rgba(42, 77, 46, 0.05);
    backdrop-filter: blur(8px);
  }
  .btn-w:hover {
    transform: translateY(-2px);
    background: #fff;
  }
  .btn svg {
    width: 15px;
    height: 15px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .btn svg.ar {
    transition: transform 0.24s;
  }
  .btn:hover svg.ar {
    transform: translateX(3px);
  }

  .hero-social {
    display: flex;
    gap: 10px;
  }
  .hero-social a {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.9);
    transition: transform 0.26s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.26s, box-shadow 0.26s;
  }
  .hero-social a:hover {
    transform: translateY(-3px);
    background: #fff;
    box-shadow: 0 6px 18px rgba(42, 77, 46, 0.16);
  }
  .hero-social svg {
    width: 17px;
    height: 17px;
    stroke: var(--color-gd);
    fill: none;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 右侧技术名片 */
  .idcard {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.97);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 52px -14px rgba(42, 77, 46, 0.2);
    overflow: hidden;
    transform: translateY(0);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.45s;
  }
  .idcard:hover {
    transform: translateY(-5px);
    box-shadow: 0 26px 66px -16px rgba(42, 77, 46, 0.26);
  }
  .idcard-hd {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 18px 20px 15px;
    border-bottom: 1px solid var(--color-line2);
  }
  .idcard-av {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
    border: 2.5px solid #fff;
    box-shadow: 0 0 0 2px var(--color-gh);
  }
  .idcard-n {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .idcard-s {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink4);
    margin-top: 1px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .idcard-live {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    /* 对比度修复：原 --color-gm (#5E8A4E) on #eaf2ce 仅 3.46:1，10px 小字不达标（需 4.5）。
       换同色系更深的 --color-gd (#3E6B3F) → 5.35:1。视觉上仍是绿色徽章。
       （Lighthouse a11y 的 color-contrast 审计项）*/
    color: var(--color-gd);
    background: #eaf2ce;
    border: 1px solid #d6e2b0;
    padding: 3px 9px;
    border-radius: 100px;
    flex: none;
  }
  .idcard-bd {
    padding: 15px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .idrow {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .idk {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--color-ink4);
    letter-spacing: 0.1em;
    font-weight: 700;
  }
  .idv {
    font-size: 13px;
    color: var(--color-ink2);
    line-height: 1.6;
    font-weight: 520;
  }
  .idv.mono {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-gd);
  }
  .idcard-ft {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--color-line2);
    background: rgba(242, 241, 228, 0.5);
  }
  .idcard-ft > div {
    padding: 12px 8px;
    text-align: center;
    border-right: 1px solid var(--color-line2);
  }
  .idcard-ft > div:last-child {
    border-right: none;
  }
  .idcard-ft b {
    display: block;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-gd);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .idcard-ft i {
    font-style: normal;
    font-size: 10px;
    color: var(--color-ink4);
    font-weight: 500;
  }

  /* ---------- 响应式：<=1000px 堆叠单列 ---------- */
  @media (max-width: 1000px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
      padding: 54px 0 58px;
    }
    .hero .lede {
      max-width: none;
    }
    .idcard {
      max-width: 440px;
    }
  }

  /* ---------- 响应式：<=700px 字号缩小 ---------- */
  @media (max-width: 700px) {
    .hero-grid {
      padding: 44px 0 50px;
    }
    .hero h1 {
      font-size: 29px;
    }
  }

  /* ---------- 减少动态效果 ---------- */
  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
    /* 荧光笔直接置为终态，不能停在 scaleX(0) 导致高亮不可见 */
    .hl::before {
      transform: rotate(-1deg) scaleX(1);
      transition: none;
    }
    /* 保留 1.05 基准缩放，只停掉过渡与视差（transform 不随鼠标变化） */
    .hero-art {
      transition: none;
    }
    .btn,
    .btn svg.ar,
    .hero-social a,
    .idcard {
      transition: none;
    }
  }
</style>

<script>
  const hero = document.getElementById('hero');
  const grid = document.getElementById('hero-grid');
  const art = document.getElementById('hero-art');
  const glow = document.getElementById('hero-glow');
  const rm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // --- 荧光笔：加载后置为终态（rm 下 CSS 已直接给出终态，这里只补类名，不产生动画） ---
  const ready = () => grid?.classList.add('hero-ready');
  addEventListener('load', ready, { once: true });
  setTimeout(ready, 600);

  // --- 视差：rm 为 true 时不注册 mousemove；触屏（无悬停指针）同样不注册 ---
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (hero && art && !rm && canHover) {
    let rx = 0;
    let ry = 0;
    let tx = 0;
    let ty = 0;

    // rAF 只在「有位移需要追」时运行，追平后自动停帧。
    //
    // 为什么不做成常驻 `(function loop(){ ... requestAnimationFrame(loop) })()`：
    // 那个写法即使鼠标从未进入 hero 区（rx/ty 恒为 0）也会每帧写一次 transform，
    // 在低端机上是一笔持续的合成开销，与本项目「Performance 99」的目标相冲突。
    // 现在是「事件点火 → 追平 → 停」，静态时零开销。
    let rafId = 0;
    let running = false;
    const EPS = 0.01;

    const frame = () => {
      rx += (tx - rx) * 0.075;
      ry += (ty - ry) * 0.075;
      art.style.transform = `translate3d(${rx.toFixed(3)}px,${ry.toFixed(3)}px,0) scale(1.05)`;
      if (Math.abs(tx - rx) < EPS && Math.abs(ty - ry) < EPS) {
        // 追平：吸附到目标值，停止循环
        rx = tx;
        ry = ty;
        art.style.transform = `translate3d(${rx.toFixed(3)}px,${ry.toFixed(3)}px,0) scale(1.05)`;
        running = false;
        return;
      }
      rafId = requestAnimationFrame(frame);
    };

    const tick = () => {
      if (running) return;
      running = true;
      rafId = requestAnimationFrame(frame);
    };

    hero.addEventListener('mousemove', (ev: MouseEvent) => {
      const r = hero.getBoundingClientRect();
      tx = ((ev.clientX - r.left) / r.width - 0.5) * 14;
      ty = ((ev.clientY - r.top) / r.height - 0.5) * 10;
      if (glow) {
        glow.style.left = ev.clientX - r.left + 'px';
        glow.style.top = ev.clientY - r.top + 'px';
      }
      tick();
    });

    hero.addEventListener('mouseleave', () => {
      tx = 0;
      ty = 0;
      tick();
    });

    // 页面不可见时不必追（切到别的标签页还跑 rAF 是纯浪费）
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && running) {
        cancelAnimationFrame(rafId);
        running = false;
      }
    });
  }
</script>
