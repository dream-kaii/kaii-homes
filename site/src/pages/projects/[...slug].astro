---
/**
 * 项目详情页 · /projects/<slug>/
 *
 * 视觉真相来源：design-mockup/project-detail-v2.html
 *   - 三栏骨架（`.shell` / `.rail-l` / `.mid` / `.toc2`）由 ContentLayout 提供
 *   - 头部 `.ahead` + `.crumb` + `.alede` + `.ameta` + `.metrics`  → L48–57, L307–316, L515–533
 *   - 左栏 `.rmeta` / `.rtags` / `.rshare` / `.rseries`           → L219–252
 *   - 右栏 `.kpi` / `.tcard`                                      → L275–291
 *   - 上一项/下一项 `.pager` / `.pg`                                → L168–175
 *   - 正文五章 + 四个组件（ProjectStages / CaseCard / ProjectLimits / SourceList）
 *     写在 `.mdx` 内容文件里，由 MDX 集成渲染
 *
 * 内容格式为什么是 `.mdx`（不是 brief 里写的 `.md`）：
 *   brief Step 1 要求在 Markdown 里直接写 `<CaseCard>`。纯 Markdown 做不到 ——
 *   默认处理器把 `<CaseCard …>` 当成字面 HTML 转义输出（实测产物里出现
 *   `&#x3C;CaseCard`），组件不渲染、构建也不报错（静默失败）。仓库已装
 *   `@astrojs/mdx` 并注册 `mdx()` 集成（Task 11 为文章页引入，本页复用），
 *   故项目正文改用 `.mdx`。配套改动只有一处：`content/config.ts` 的 `projects`
 *   从 `type: 'content'` 换成 glob loader（同时吃 `.md` 与 `.mdx`），schema 逐字未动。
 *
 * 锚点方案（规格修补 4，方案 2）：
 *   内容文件里**不写**显式锚点标记（`## 标题` 后面的花括号 id）。右栏目录从 `render()` 返回的
 *   `headings` 动态构造 `href: '#' + h.slug`，与标题文本永远一致。
 *   为什么不用方案 1（`## 标题` 后跟花括号包起的锚点）：MDX 把 花括号表达式 当 JSX 表达式解析，
 *   `#sec1` 不是合法 JS，构建会以 `Could not parse expression with acorn`
 *   直接终止（本任务实测踩过）。方案 2 对 MDX 与纯 Markdown 都成立，
 *   且标题改动时目录自动跟随，是这里唯一稳的选择。
 *
 * `scroll-margin-top`（规格修补 5）：
 *   该规则的正主是 `.prose-k`，约定由 Task 11 在 `global.css` 统一定义。
 *   本页落地时 `global.css` 里还没有这条（实测 `grep scroll-margin` 为空），
 *   故本页 `<style>` 带一份**同值兜底**（84px = nav 64 + 20 缓冲）。
 *   同值叠加幂等，Task 11 落地后可安全删除本节。
 */
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import TocList from '../../components/TocList.astro';
import ProgressRing from '../../components/ProgressRing.astro';

export async function getStaticPaths() {
  const items = await getCollection('projects');
  if (items.length === 0) throw new Error('projects 内容集合为空，至少需要 1 个项目');
  return items.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
// glob loader 的集合用 `render(entry)`（Astro 5 Content Layer API），
// 不是旧式 `entry.render()`。
const { Content, headings } = await render(project);

// 规格修补 4：目录从 headings 动态构造，不写死锚点。
const toc = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ href: '#' + h.slug, label: h.text }));

// 左栏「其他项目」：projects 集合本身（按 order 排），去掉当前页自己。
// 数据源用 content collection 而不是 src/data/projects.ts —— 详情页的
// 「其他项目」必须和真实存在的路由一致，不能指向一个不存在的 slug。
const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const siblings = all.filter((p) => p.id !== project.id);

// 上一项 / 下一项：同一条 order 序列上取邻位。
const idx = all.findIndex((p) => p.id === project.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;

// 卡片编号：order → '01'…'03'，与首页 Task 8 的 index 口径一致。
const indexOf = (order: number) => String(order).padStart(2, '0');

const badge = project.data.nature.includes('课程') ? '课程项目 · 主线' : '个人项目';

// 「按阶段跳转」三张卡：设计稿把它们全部指向第 2 章（架构）。
// 三个项目的章节数不同（10 / 5 / 6），硬编码「CH01–CH04」这样的区间会造假；
// 故保留设计稿「三张卡同指架构章」的行为，文案改为语义化，不虚构区间。
const stageHead =
  headings.find((h) => h.depth === 2 && h.text.includes('架构')) ??
  headings.find((h) => h.depth === 2);
const stageCards = [
  { k: '检索与质量', t: '向量 · 混合 · 重排', d: '内容如何被找到' },
  { k: '编排与理解', t: '图编排 · 意图 · 上下文', d: '请求如何被走完' },
  { k: '工程与运维', t: '可观测 · 工具系统 · 微调', d: '系统如何被维护' },
];
const stageHref = stageHead ? '#' + stageHead.slug : '#';
---

<ContentLayout title={`${project.data.title} — kaii`} description={project.data.subtitle} active="projects">
  <!-- ============ 左栏：进度环 + 项目信息 + 技术栈 + 操作 + 其他项目 ============ -->
  <div slot="left" class="text-right">
    <ProgressRing />

    <div class="mb-5 border-b border-line2 pb-5">
      <h5 class="mb-3 font-mono text-[9.5px] font-bold tracking-[.11em] text-ink4">项目信息</h5>
      <dl class="grid grid-cols-[auto_1fr] justify-end gap-x-3 gap-y-[7px]">
        <dt class="text-right font-mono text-[10.5px] text-ink4">角色</dt>
        <dd class="text-left text-[12.5px] font-medium text-ink2">{project.data.role}</dd>
        <dt class="text-right font-mono text-[10.5px] text-ink4">性质</dt>
        <dd class="text-left text-[12.5px] font-medium text-ink2">{project.data.nature}</dd>
        <dt class="text-right font-mono text-[10.5px] text-ink4">状态</dt>
        <dd class="text-left text-[12.5px] font-medium text-ink2">
          {project.data.status === 'completed' ? '已完成' : '进行中'}
        </dd>
        <dt class="text-right font-mono text-[10.5px] text-ink4">年份</dt>
        <dd class="text-left text-[12.5px] font-medium text-ink2">{project.data.year}</dd>
      </dl>
    </div>

    <div class="mb-5 border-b border-line2 pb-5">
      <h5 class="mb-3 font-mono text-[9.5px] font-bold tracking-[.11em] text-ink4">技术栈</h5>
      <div class="flex flex-wrap justify-end gap-1.5">
        {
          project.data.stack.map((s) => (
            <span class="rounded-full border border-line bg-paper2 px-2.5 py-1 font-mono text-[10.5px] text-gm">
              {s}
            </span>
          ))
        }
      </div>
    </div>

    {
      project.data.repo && (
        <div class="mb-5 border-b border-line2 pb-5">
          <h5 class="mb-3 font-mono text-[9.5px] font-bold tracking-[.11em] text-ink4">操作</h5>
          <div class="flex flex-col items-end gap-2">
            <a
              href={project.data.repo}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1.5 rounded-full border border-line bg-card px-3.5 py-[7px] font-mono text-[10.5px] text-ink3 no-underline transition hover:border-gh hover:text-gd"
            >
              GitHub 仓库
            </a>
            <a
              href="/projects/"
              class="inline-flex items-center gap-1.5 rounded-full border border-line bg-card px-3.5 py-[7px] font-mono text-[10.5px] text-ink3 no-underline transition hover:border-gh hover:text-gd"
            >
              全部项目
            </a>
          </div>
        </div>
      )
    }

    <div class="flex flex-col gap-0.5">
      <h5 class="mb-2.5 font-mono text-[9.5px] font-bold tracking-[.11em] text-ink4">其他项目</h5>
      {
        siblings.map((s) => (
          <a
            href={`/projects/${s.id}/`}
            class="grid grid-cols-[22px_1fr] items-baseline gap-x-2 gap-y-0.5 rounded-[9px] border border-transparent px-2.5 py-2 text-left no-underline transition hover:border-line hover:bg-paper2"
          >
            <span class="font-mono text-[10px] font-bold text-gh">{indexOf(s.data.order)}</span>
            <span class="text-[12.3px] font-medium leading-snug text-ink3">{s.data.title}</span>
            <span class="col-start-2 font-mono text-[9.5px] text-ink4">
              {s.data.metrics[0]?.value} {s.data.metrics[0]?.label}
            </span>
          </a>
        ))
      }
    </div>
  </div>

  <!-- ============ 中栏：头部 + 正文五章（组件在 MDX 里内嵌） ============ -->
  <article class="prose-k">
    <header class="ahead">
      <div class="crumb">
        <a href="/projects/">项目</a> / {project.data.title.split(' · ')[0]}
      </div>
      <h1>{project.data.title}</h1>
      <p class="alede">{project.data.subtitle}</p>
      <div class="ameta">
        <span>{project.data.year}</span>
        <div class="tg">
          <span>{badge}</span>
          <span>{project.data.stack[0]}</span>
        </div>
      </div>

      <div class="metrics rv">
        {
          project.data.metrics.map((m) => (
            <div class="met">
              <b>{m.value}</b>
              <i>{m.label}</i>
            </div>
          ))
        }
      </div>
    </header>

    <Content />

    {
      /* 上一项 / 下一项（设计稿 L705–710）。
         设计稿的 pager 是固定邻居；这里用 order 序列算真实邻居，边界侧缺项就不渲染，
         只剩一格时由 CSS `:only-child` 占满整行，不留半行空白。 */
      (prev || next) && (
        <nav class="pager" aria-label="项目间导航">
          {prev && (
            <a href={`/projects/${prev.id}/`} class="pg prev">
              <span class="k">← 上一个项目</span>
              <span class="t">{prev.data.title}</span>
            </a>
          )}
          {next && (
            <a href={`/projects/${next.id}/`} class="pg next">
              <span class="k">下一个项目 →</span>
              <span class="t">{next.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>

  <!-- ============ 右栏：目录 + 关键数据 + 阶段跳转 ============ -->
  <div slot="right">
    <TocList items={toc} heading="本页目录" />

    <div class="mt-7 border-t border-line2 pt-5">
      <h5 class="mb-2.5 font-mono text-[9.5px] font-bold tracking-[.11em] text-ink4">关键数据</h5>
      {
        project.data.metrics.map((m) => (
          <div class="kpi">
            <b>{m.value}</b>
            <i>{m.label}</i>
          </div>
        ))
      }
    </div>

    {
      stageCards.length > 0 && (
        <div class="mt-7 border-t border-line2 pt-5">
          <h5 class="mb-2.5 font-mono text-[9.5px] font-bold tracking-[.11em] text-ink4">按阶段跳转</h5>
          {stageCards.map((c, i) => (
            <a href={stageHref} class:list={['tcard', i === 0 && 'on']}>
              <span class="tk">{c.k}</span>
              <span class="tt">{c.t}</span>
              <span class="td">{c.d}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</ContentLayout>

<style>
  /* ============================================================
     本页局部样式：设计稿 project-detail-v2.html 的 `.ahead` 组（L48–57）、
     `.ameta`（L54–57）、`.metrics/.met`（L307–316）、`.kpi`（L276–280）、
     `.tcard`（L283–291）、`.pager/.pg`（L168–175）。

     为什么放在页面里而不是抽成组件：它们都只有一个消费点（详情页头部 / 右栏）。
     CaseCard / ProjectStages / ProjectLimits / SourceList 有跨页复用预期
     （Task 11 的文章页会复用 SourceList），所以那些才抽成组件。

     Global Constraints #1：一律不用 padding / margin 简写覆盖 Tailwind 类。
     ============================================================ */

  /* ---------- 锚点偏移（规格修补 5） ---------- */
  .prose-k :global(h2),
  .prose-k :global(h3) {
    scroll-margin-top: 84px;
  }

  /* ---------- 头部（设计稿 L48–57） ---------- */
  .prose-k :global(.ahead) {
    padding-top: 56px;
    padding-bottom: 34px;
  }
  .prose-k :global(.crumb) {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-ink4);
    margin-bottom: 18px;
  }
  .prose-k :global(.crumb a) {
    color: var(--color-ink4);
    text-decoration: none;
    transition: 0.2s;
  }
  .prose-k :global(.crumb a:hover) {
    color: var(--color-gd);
  }
  .prose-k h1 {
    font-size: clamp(28px, 3.9vw, 40px);
    font-weight: 800;
    letter-spacing: -0.034em;
    line-height: 1.2;
    margin-bottom: 18px;
  }
  .prose-k :global(.alede) {
    font-size: 16.5px;
    color: var(--color-ink2);
    line-height: 1.8;
    margin-bottom: 22px;
  }
  .prose-k :global(.ameta) {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    align-items: center;
    font-size: 12.5px;
    color: var(--color-ink4);
    font-family: var(--font-mono);
  }
  .prose-k :global(.ameta .tg) {
    display: flex;
    gap: 6px;
  }
  .prose-k :global(.ameta .tg span) {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-gd);
    background: var(--color-paper2);
    border: 1px solid var(--color-line);
    padding: 3px 9px;
    border-radius: 100px;
  }

  /* ---------- 头部指标卡（设计稿 L307–316） ---------- */
  .prose-k :global(.metrics) {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 13px;
    margin-top: 26px;
  }
  .prose-k :global(.met) {
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: 15px;
    padding: 17px 15px;
    text-align: center;
    box-shadow: 0 1px 3px rgba(42, 77, 46, 0.05);
    transition: all 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .prose-k :global(.met:hover) {
    transform: translateY(-3px);
    box-shadow: 0 6px 22px -6px rgba(42, 77, 46, 0.11);
    border-color: var(--color-gh);
  }
  .prose-k :global(.met b) {
    display: block;
    font-family: var(--font-mono);
    font-size: 24px;
    font-weight: 700;
    color: var(--color-gd);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }
  .prose-k :global(.met i) {
    font-style: normal;
    font-size: 11px;
    color: var(--color-ink3);
    font-weight: 500;
  }

  /* ---------- 右栏 KPI 行（设计稿 L276–280）
     内容在 `slot="right"` 里，跨组件边界，故用 :global。 ---------- */
  :global(.kpi) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 9px 0;
    border-bottom: 1px dashed var(--color-line2);
  }
  :global(.kpi:last-child) {
    border-bottom: none;
  }
  :global(.kpi b) {
    font-family: var(--font-mono);
    font-size: 19px;
    font-weight: 700;
    color: var(--color-gd);
    letter-spacing: -0.03em;
  }
  :global(.kpi i) {
    font-style: normal;
    font-size: 11px;
    color: var(--color-ink4);
  }

  /* ---------- 右栏可点阶段卡（设计稿 L283–291） ---------- */
  :global(.tcard) {
    display: block;
    text-decoration: none;
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: 12px;
    padding: 12px 14px;
    margin-bottom: 8px;
    transition: all 0.26s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 1px 3px rgba(42, 77, 46, 0.05);
  }
  :global(.tcard:hover) {
    border-color: var(--color-gh);
    transform: translateX(3px);
    box-shadow: 0 6px 22px -6px rgba(42, 77, 46, 0.11);
  }
  :global(.tcard.on) {
    border-color: var(--color-gd);
    background: linear-gradient(140deg, #f4f9e6, #eaf2ce);
  }
  :global(.tcard .tk) {
    display: block;
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    color: var(--color-gh);
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }
  :global(.tcard.on .tk) {
    color: var(--color-gd);
  }
  :global(.tcard .tt) {
    display: block;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-ink2);
    line-height: 1.5;
  }
  :global(.tcard.on .tt) {
    color: var(--color-gd);
  }
  :global(.tcard .td) {
    display: block;
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--color-ink4);
    margin-top: 3px;
  }

  /* ---------- 上一项 / 下一项（设计稿 L168–175） ---------- */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 26px;
  }
  .pager > .pg:only-child {
    grid-column: 1 / -1;
  }
  .pg {
    display: block;
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    padding: 16px 18px;
    text-decoration: none;
    box-shadow: 0 1px 3px rgba(42, 77, 46, 0.05);
    transition: all 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pg:hover {
    border-color: var(--color-gh);
    transform: translateY(-3px);
    box-shadow: 0 6px 22px -6px rgba(42, 77, 46, 0.11);
  }
  .pg .k {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-ink4);
    letter-spacing: 0.08em;
    margin-bottom: 6px;
  }
  .pg .t {
    display: block;
    font-size: 13.8px;
    font-weight: 600;
    color: var(--color-ink2);
    line-height: 1.5;
    transition: color 0.2s;
  }
  .pg:hover .t {
    color: var(--color-gd);
  }
  .pg.next {
    text-align: right;
  }

  /* ---------- 响应式（设计稿 L378–389） ---------- */
  @media (max-width: 820px) {
    .prose-k :global(.metrics) {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 700px) {
    .prose-k :global(.ahead) {
      padding-top: 32px;
      padding-bottom: 24px;
    }
    .prose-k :global(.metrics) {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .prose-k :global(.met) {
      padding: 14px 12px;
    }
    .prose-k :global(.met b) {
      font-size: 21px;
    }
    .prose-k :global(.ameta) {
      flex-wrap: wrap;
      gap: 10px;
    }
    .prose-k :global(.ameta .tg) {
      flex-wrap: wrap;
    }
    .prose-k h1 {
      font-size: 26px;
      word-break: break-word;
      overflow-wrap: anywhere;
    }
    .prose-k :global(.alede) {
      font-size: 14.5px;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .pg.next {
      text-align: left;
    }
    :global(.tcard) {
      padding: 11px 13px;
    }
  }
  @media (max-width: 420px) {
    .prose-k :global(.ahead) {
      padding-top: 28px;
    }
    .prose-k h1 {
      font-size: 23px;
    }
    .prose-k :global(.met b) {
      font-size: 19px;
    }
  }

  /* ---------- 减少动态效果：直接置终态，不留中间态 ---------- */
  @media (prefers-reduced-motion: reduce) {
    .prose-k :global(.met),
    :global(.tcard),
    .pg {
      transition: none;
    }
    .prose-k :global(.met:hover),
    :global(.tcard:hover),
    .pg:hover {
      transform: none;
    }
    .pg .t {
      transition: none;
    }
  }

  /* ---------- 无 JS 兜底 ----------
     头部指标卡带 `.rv`（滚动入场）。global.css 的 `:root:not(.js) .rv` 是
     后代选择器，`.metrics` 自身即 `.rv` 元素时需要自己兜一层（Global Constraints #4）。 */
  :root:not(.js) .prose-k :global(.metrics.rv),
  :root:not(.js) .prose-k :global(.met),
  :root:not(.js) :global(.tcard),
  :root:not(.js) .pg {
    opacity: 1;
    transform: none;
    transition: none;
  }
</style>
